# ==========================================
# TripWise Backend Environment Configuration (Example)
# ==========================================

PORT=8080
HOST=0.0.0.0
DEBUG=True

DATABASE_URL=sqlite:///./tripwise.db

JWT_SECRET=tripwise_super_secure_jwt_secret_token_key_change_in_production_32chars!
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- ADD YOUR API KEYS HERE (OPTIONAL) ---
